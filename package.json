{
  "name": "dnbradio",
  "version": "1.0.0",
  "description": "dnbradio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs /player/",
    "generate-prod": "node scripts/build.mjs /player/",
    "generate-cloudflare": "node scripts/build.mjs /",
    "generate": "node scripts/build.mjs /player-dev/",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "start": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "butterchurn": "3.0.0-beta.5",
    "butterchurn-presets": "3.0.0-beta.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.3",
    "vuex": "^4.1.0",
    "webamp": "2.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.6.2",
    "vite": "^8.3.5"
  }
}
